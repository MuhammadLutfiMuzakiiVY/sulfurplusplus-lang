(* ============================================================
   Sulfur++ Formal Grammar — Pattern Matching
   File: docs/language/grammar/patterns.ebnf
   Status: Derived from Parser::parseMatch()
   ============================================================ *)


(* ---- Current Implementation (v0.1) ---- *)
(* Match patterns in v0.1 are expression-based, not structural.
   The parser evaluates each pattern as an expression and compares
   via equality. The only special pattern is '_' (wildcard/default). *)

match_pattern       ::= '_'                  (* wildcard, default case *)
                      | expression ;          (* compared via equality *)

match_case          ::= match_pattern '=>' block ;
    (* AST: MatchCase { pattern, body, line }
       pattern is nullptr for wildcard '_' *)


